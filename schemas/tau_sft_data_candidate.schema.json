{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["assistant_turns", "rationale", "risk_checks"],
  "properties": {
    "assistant_turns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["content", "tool_calls"],
        "properties": {
          "content": {"type": ["string", "null"]},
          "tool_calls": {
            "type": ["array", "null"],
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "arguments"],
              "properties": {
                "name": {"type": "string"},
                "arguments": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "rationale": {"type": "string"},
    "risk_checks": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
